
##################################################
# 玩家机器人配置文件                             #
##################################################

###################################################################################################
#
#
#
#
#
###################################################################################################

###################################
#                                 #
# GENERAL SETTINGS                #
#                                 #
###################################

####################################################################################################

# 启用或禁用 AI 玩家机器人
AiPlayerbot.Enabled = 1

# 启用随机机器人系统
AiPlayerbot.RandomBotAutologin = 1

# 随机机器人数量
AiPlayerbot.MinRandomBots = 1000
AiPlayerbot.MaxRandomBots = 1200

# 随机机器人账户
# 如果您没有使用任何资料片，请手动设置此参数，然后
# 确保 RandomBotAccountCount 至少大于 (MaxRandomBots / 10 + AddClassAccountPoolSize)
# 默认：0 - 自动
AiPlayerbot.RandomBotAccountCount = 0

# 删除所有随机机器人账户（重置随机机器人）这里的0改成1就是删除所有机器人，重新刷新。
AiPlayerbot.DeleteRandomBotAccounts = 0

###################################################################################################

###################################
#                                 #
# PLAYERBOT SETTINGS              #
#                                 #
###################################

####################################################################################################

####################################################################################################
# GENERAL
#
#

# 单个玩家可以同时控制的最大机器人数量
AiPlayerbot.MaxAddedBots = 40

# 启用/禁用通过 addclass 命令创建机器人（0 = 仅限 GM，1 = 启用）
# 默认：1（启用）
AiPlayerbot.AddClassCommand = 1

# 设置 addclass 命令的账户池大小
AiPlayerbot.AddClassAccountPoolSize = 200

# 机器人组邀请权限级别（0 = 仅限 GM，1 = 根据等级接受，2 = 总是接受）
# 默认：1（根据等级接受）
AiPlayerbot.GroupInvitationPermission = 1

# 登录时自动登录玩家的所有小号作为机器人
AiPlayerbot.BotAutologin = 0

# 允许/禁止玩家账户的机器人
AiPlayerbot.AllowAccountBots = 1

# 允许/禁止玩家公会的机器人
AiPlayerbot.AllowGuildBots = 1

# 随机机器人公会数量
AiPlayerbot.RandomBotGuildCount = 20

# 删除所有随机机器人公会
AiPlayerbot.DeleteRandomBotGuilds = 0

# 随机机器人邀请附近的机器人加入公会
AiPlayerbot.RandomBotGuildNearby = 0

# 随机机器人邀请玩家加入队伍/团队/公会
AiPlayerbot.RandomBotInvitePlayer = 0

# 邀请其他机器人加入队伍/团队/公会时，机器人会在公会/说频道聊天
AiPlayerbot.InviteChat = 1

# 接受组邀请时将机器人召唤到玩家身边
AiPlayerbot.SummonWhenGroup = 1

# 添加以下配置
# 自机器人权限级别（0 = 禁用，1 = 仅限 GM（默认），2 = 所有玩家，3 = 登录时激活）
AiPlayerbot.SelfBotLevel = 1

# 为机器人提供免费食物
# 默认：1（启用）
AiPlayerbot.FreeFood = 1

# 非 GM 玩家只能使用 init=auto 根据自己的等级和装备分数初始化机器人
# 默认：0（非 GM 玩家可以使用任何初始化命令）
AiPlayerbot.AutoInitOnly = 0

# 基于 init=auto 的机器人装备等级上限比率
# 默认：1.0（与玩家相同）
AiPlayerbot.AutoInitEquipLevelLimitRatio = 1.0

# 机器人与训练师对话时自动训练技能（yes = 训练所有可用技能，前提是机器人有钱，free = 自动训练且无需花费金钱，no = 仅列出技能）
AiPlayerbot.AutoTrainSpells = free

#
#
#
####################################################################################################

####################################################################################################
# SUMMON OPTIONS
#
#

# 启用/禁用在主人战斗时召唤机器人
# 默认：1（启用）
AiPlayerbot.AllowSummonInCombat = 1

# 启用/禁用在主人死亡时召唤机器人
# 默认：1（启用）
AiPlayerbot.AllowSummonWhenMasterIsDead = 1

# 启用/禁用在机器人死亡时召唤（0 = 仅当机器人为鬼魂时，1 = 总是）
# 默认：1（总是）
AiPlayerbot.AllowSummonWhenBotIsDead = 1

# 启用/禁用召唤时复活机器人（0 = 禁用，1 = 在战斗中禁用，2 = 启用）
# 默认：1（在战斗中禁用）
AiPlayerbot.ReviveBotWhenSummoned = 1

# 启用/禁用召唤时修复机器人装备（0 = 否，1 = 是）
# 默认：1
AiPlayerbot.BotRepairWhenSummon = 1

#
#
#
####################################################################################################

####################################################################################################
# MOUNT
#
#

# 定义机器人自然使用 60% 陆地坐骑的等级
# 注意：在 WotLK 期间为 20 级，TBC 期间为 30 级，Vanilla 期间为 40 级
# 默认：20
AiPlayerbot.UseGroundMountAtMinLevel = 20

# 定义机器人自然使用 100% 快速陆地坐骑的等级
# 注意：在 WotLK 期间为 40 级，Vanilla 期间为 60 级
# 默认：40
AiPlayerbot.UseFastGroundMountAtMinLevel = 40

# 定义机器人自然使用 150% 飞行坐骑的等级
# 注意：在 WotLK 期间为 60 级，TBC 期间为 70 级
# 默认：60
AiPlayerbot.UseFlyMountAtMinLevel = 60

# 定义机器人自然使用 280% 快速飞行坐骑的等级
# 注意：在 WotLK 和 TBC 期间为 70 级
# 默认：70
AiPlayerbot.UseFastFlyMountAtMinLevel = 70

#
#
#
####################################################################################################

####################################################################################################
# GEAR
#
#

# 显示随机机器人的头盔和披风（需要重置）
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# 机器人会装备升级（如果机器人从掉落或任务中获得更好的装备，他们会装备）
# 默认：1（启用）
AiPlayerbot.AutoEquipUpgradeLoot = 1

# 装备升级阈值
# 默认：1.1（当装备分数是当前的 1.1 倍时装备）
AiPlayerbot.EquipUpgradeThreshold = 1.1

# 两轮装备初始化以创建更合适的装备
AiPlayerbot.TwoRoundsGearInit = 0

#
#
#
####################################################################################################

####################################################################################################
# LOOTING
#
#

# 收集物品时机器人会说出物品信息
AiPlayerbot.SayWhenCollectingItems = 1

# 当组掉落方法为自由拾取时，机器人会继续拾取
# 默认：0（禁用）
AiPlayerbot.FreeMethodLoot = 1

# 机器人掉落滚动等级（0 = 放弃，1 = 贪婪，2 = 需要）
# 默认：1（贪婪）
AiPlayerbot.LootRollLevel = 2

#
#
#
####################################################################################################

####################################################################################################
# TIMERS
#
#

# 每次滴答的最大 AI 迭代次数
AiPlayerbot.IterationsPerTick = 10

# 两个短时间法术施法之间的延迟
AiPlayerbot.GlobalCooldown = 500

# 移动时的最大等待时间
AiPlayerbot.MaxWaitForMove = 5000

# 禁用 MoveSplinePath 以使机器人移动更加随机，但会使定身/减速/束缚等效果对机器人生效（当 MoveSplinePath 启用时，这些效果可能不会可靠地生效，尽管减速效果仍然有效）
# 默认：0 - 启用 MoveSplinePath
#          1 - 仅在战场/竞技场中禁用 MoveSplinePath
#          2 - 处处禁用 MoveSplinePath
AiPlayerbot.DisableMoveSplinePath = 0

# 移动搜索时间的最大值（值越高，在斜坡上移动越好）
# 默认：3
AiPlayerbot.MaxMovementSearchTime = 3

# 动作过期时间
AiPlayerbot.ExpireActionTime = 5000

# 最大驱散光环持续时间
AiPlayerbot.DispelAuraDuration = 700

# 机器人动作之间的延迟
AiPlayerbot.ReactDelay = 100

# 根据机器人不同状态动态调整反应延迟以减少服务器延迟
AiPlayerbot.DynamicReactDelay = 1

# 不活动延迟
AiPlayerbot.PassiveDelay = 10000

# 重复动作（聊天消息、表情等）的最小延迟
AiPlayerbot.RepeatDelay = 2000

# 延迟计时器
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
# ReturnDelay 的最小值为 2000 - 更低的值会导致崩溃！
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

#
#
#
####################################################################################################

####################################################################################################
# DISTANCES
#
#

AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 75.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 5.0
AiPlayerbot.ReactDistance = 150.0
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 15.0
AiPlayerbot.FleeDistance = 5.0
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 0.75
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.45
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.AggroDistance = 22

#
#
#
####################################################################################################

####################################################################################################
#THRESHOLDS
#
#

# 设置机器人的经验值（默认：1.0）
# 服务器经验值率 * AiPlayerbot.PlayerbotsXPRate
AiPlayerbot.PlayerbotsXPRate = 1.0

# 健康值/法力值等级
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# 机器人选择任务奖励（yes = 选择最有用的物品，no = 列出所有奖励，ask = 选择有用物品并在有多个选项时列出）
AiPlayerbot.AutoPickReward = yes

# 与玩家同步任务（机器人会在你交任务时立即完成任务。机器人会忽略拾取任务物品）
# 默认：1（启用）
AiPlayerbot.SyncQuestWithPlayer = 1

# 机器人会为玩家自动完成任务当交任务时
# 默认：0（禁用）
AiPlayerbot.SyncQuestForPlayer = 1

# 机器人会丢弃过时的任务
# 默认：1（启用）
AiPlayerbot.DropObsoleteQuests = 1

#
#
#
####################################################################################################

####################################################################################################
# COMBAT
#
#

# 进入副本时自动添加副本/团队策略（如果已实现）
AiPlayerbot.ApplyInstanceStrategies = 1

# 启用自动躲避范围攻击（实验性）
# 默认：1（启用）
AiPlayerbot.AutoAvoidAoe = 1

# 仅躲避半径小于此值的范围攻击
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# 范围攻击躲避白名单（不会被躲避的范围攻击法术 ID 列表）
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810

# 启用治疗机器人节省法力值
# 默认：1（启用）
AiPlayerbot.AutoSaveMana = 1

# 治疗机器人节省法力值的阈值
# 默认：60（60%）
AiPlayerbot.SaveManaThreshold = 60

# 机器人可以逃跑
AiPlayerbot.FleeingEnabled = 1

#
#
#
####################################################################################################

####################################################################################################
# CHEATS
#
#

# 启用/禁用维护命令，学习所有可用技能和法术，补充消耗品，修复装备等
# 默认：1（启用）
AiPlayerbot.MaintenanceCommand = 1

# 启用/禁用自动装备命令，自动升级玩家机器人的装备，装备质量受限于 AutoGearQualityLimit 和 AutoGearScoreLimit
# 默认：1（启用）
AiPlayerbot.AutoGearCommand = 1

# 启用/禁用玩家小号机器人的自动装备命令
# 默认：1（启用）
AiPlayerbot.AutoGearCommandAltBots = 1

# 自动装备命令的装备质量限制（1 = 普通，2 = 不常见，3 = 稀有，4 = 精良，5 = 史诗）
# 默认：3（稀有）
AiPlayerbot.AutoGearQualityLimit = 3

# 自动装备命令的装备分数（非装备等级）限制（0 = 无限制）
# 默认：0（无限制）
AiPlayerbot.AutoGearScoreLimit = 0

# 启用/禁用机器人作弊
AiPlayerbot.BotCheats = "taxi"

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# 用于打开可掉落宝箱的法术 ID
AiPlayerbot.OpenGoSpell = 6477

#
#
#
###################################################################################################

#######################################
#                                     #
# PLAYERBOT RNDBOT SPECIFIC SETTINGS  #
#                                     #
#######################################

####################################################################################################
# GENERAL
#
#

# 启用/禁用机器人账户密码
AiPlayerbot.RandomBotRandomPassword = 0

# 随机机器人账户前缀
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 80

# 与在线玩家的最高等级同步最大随机机器人等级
# 默认：0（禁用）
AiPlayerbot.SyncLevelWithPlayers = 0

# 将许多任务标记为完成（减慢机器人创建速度）
AiPlayerbot.PreQuests = 0

# 启用随机机器人加入 LFG
AiPlayerbot.RandomBotJoinLfg = 1

# 启用/禁用定期上线/下线以模拟现实场景中并非所有玩家同时在线
# 启用时，会随机选择机器人定期上线或下线
# 默认：0（禁用，在线机器人集合保持固定）
AiPlayerbot.EnablePeriodicOnlineOffline = 0

# 总机器人数量（包括离线机器人）与当前在线机器人数量（MaxRandomBots）的比率
# 该设置必须大于 1.0 且仅在 EnablePeriodicOnlineOffline 启用时应用
# 默认：2.0（总机器人数量是 MaxRandomBots 的两倍）
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# 联盟和部落的比例
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# 禁用死亡骑士机器人登录
AiPlayerbot.DisableDeathKnightLogin = 0

# 启用扩展限制以用于天赋和符文，即：60 级及以下的机器人仅使用 Vanilla 中可用的天赋，70 级及以下的机器人仅使用 TBC 中的天赋
# 默认：0
AiPlayerbot.LimitTalentsExpansion = 0

# 允许随机机器人进行交易
AiPlayerbot.EnableRandomBotTrading = 1
#
#
#
####################################################################################################

####################################################################################################
# LEVELS
#
#

# 禁用随机机器人的随机等级
# 所有机器人从指定等级开始并通过击杀怪物升级
AiPlayerbot.DisableRandomLevels = 0

# 如果启用了 "AiPlayerbot.DisableRandomLevels"，在这里设置随机机器人的起始等级
AiPlayerbot.RandombotStartingLevel = 1

# 随机机器人首次随机化时有最小等级的概率（默认 0.1）
AiPlayerbot.RandomBotMinLevelChance = 0.1

# 随机机器人首次随机化时有最大等级的概率（默认 0.1）
AiPlayerbot.RandomBotMaxLevelChance = 0.1

# 固定随机机器人的等级（不会通过打怪升级）
# 默认：0（禁用）
AiPlayerbot.RandomBotFixedLevel = 0

# 将最大等级机器人设置为最小等级或不设置
AiPlayerbot.DowngradeMaxLevelBot = 0

#
#
#
####################################################################################################

####################################################################################################
# GEAR
#
#

# 随机机器人的装备质量限制（1 = 普通，2 = 不常见，3 = 稀有，4 = 精良，5 = 史诗）
# 默认：3（稀有）
AiPlayerbot.RandomGearQualityLimit = 4

# 随机机器人的装备分数限制（0 = 无限制）
# 默认：0（无限制）
AiPlayerbot.RandomGearScoreLimit = 0

# 设置随机机器人获得附魔的最高等级（最大等级 + 1 禁用）
# 默认：60
AiPlayerbot.MinEnchantingBotLevel = 1

# 启用扩展限制以用于附魔，即：60 级及以下的机器人仅使用 Vanilla 中可用的附魔，70 级及以下的机器人仅使用 TBC 中的附魔
# 默认：1
AiPlayerbot.LimitEnchantExpansion = 1

# 启用扩展限制以用于装备，即：60 级及以下的机器人仅使用 Vanilla 中可用的装备，70 级及以下的机器人仅使用 TBC 中的装备
# 默认：1
AiPlayerbot.LimitGearExpansion = 1

# 更改随机机器人的装备等级较低
AiPlayerbot.RandomGearLoweringChance = 0

# 随机机器人会检查玩家装备分数并在分数过低时拒绝组队邀请
# 默认：0（禁用）
AiPlayerbot.GearScoreCheck = 0

# 启用/禁用机器人装备持久化（停止随机初始化）在特定等级后（EquipmentPersistenceLevel）
# 默认：0（禁用）
AiPlayerbot.EquipmentPersistence = 0

# 默认：80
AiPlayerbot.EquipmentPersistenceLevel = 80

# 随机机器人在升级时自动升级装备
# 默认：1（启用）
AiPlayerbot.AutoUpgradeEquip = 1

# 仅为猎人设置狼宠物以获得更高伤害（0 = 禁用，1 = 启用仅限最高等级，2 = 启用）
# 默认：0（禁用）
AiPlayerbot.HunterWolfPet = 0

#
#
#
####################################################################################################


####################################################################################################
# ACTIVITIES
#
#
# 指定活跃机器人的百分比
# 默认为 100%，但如果不启用 botActiveAloneSmartScale，
# 则会自动调整。无论怎样，这个值仅应用于检测到没有真实玩家的非活跃区域。当真实玩家在附近、好友、组队、公会、战场、副本等时，
# 该值始终强制为 100%
AiPlayerbot.BotActiveAlone = 100

# 当机器人在真实玩家的...范围内时强制 botActiveAlone
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 1
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# SmartScale 是否启用。
# 默认为 1。当启用（智能）时，根据延迟调整 'BotActiveAlone' 值。
# （延迟超过限制时开始应用缩放）
#
#   Limitfloor - 当延迟超过地板值时，开始应用活动缩放，从 90% 开始
#   LimitCeiling - 当延迟超过天花板值时，活动为 0%；
#
#   MinLevel - 仅在机器人等级大于或等于最小等级时应用缩放
#   MaxLevel - 仅在机器人等级小于或等于最大等级时应用缩放
#
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 80

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# 将完成并奖励给所有随机机器人的任务
AiPlayerbot.RandomBotQuestIds = "7848,3802,5505,6502,7761,10277,10285,11492,24499,24511,24710,24712"

# 随机机器人会与附近机器人组队完成共享任务
AiPlayerbot.RandomBotGroupNearby = 0

# 随机机器人会自行选择任务并尝试完成
# 默认：1（启用）
AiPlayerbot.AutoDoQuests = 1

# 随机机器人会表现得更像真实玩家（实验性）
# 该选项会覆盖 AutoDoQuests
# 默认：1（启用）
AiPlayerbot.EnableNewRpgStrategy = 1

# 保留的任务物品（不要销毁）
AiPlayerbot.RandomBotQuestItems = "6948,5175,5176,5177,5178,16309,12382,13704,11000"

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# 随机机器人在升级时自动学习任务奖励法术
# 默认：0（禁用）
AiPlayerbot.AutoLearnQuestSpells = 1

# 随机机器人在升级时自动学习可训练法术
# 默认：1（启用）
AiPlayerbot.AutoLearnTrainerSpells = 1

# 随机机器人在升级时自动选择天赋点
# 默认：1（启用）
AiPlayerbot.AutoPickTalents = 1

# 每个随机机器人在随机化时都会学习的法术（54197 - 寒冷天气飞行）
AiPlayerbot.RandomBotSpellIds = "54197"

#
#
