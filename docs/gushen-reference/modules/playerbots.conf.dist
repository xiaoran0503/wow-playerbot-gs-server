###################################################################################################


###################################
#                                 #
# PLAYERBOT SYSTEM SETTINGS       #
#                                 #
###################################

####################################################################################################
# DATABASE & CONNECTIONS
#
#

#    PlayerbotsDatabaseInfo
#        描述：玩家机器人服务器的数据库连接设置。
#        示例： "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - （在 Windows 上使用命名管道
#                                                                 "enable-named-pipe" 在 [mysqld]
#                                                                 my.ini 部分）
#                     ".;/path/to/unix_socket;username;password;database" - （在
#                                                                           Unix/Linux 上使用 Unix 套接字）
#        默认：     "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_playerbots"

#
#    PlayerbotsDatabase.WorkerThreads
#        描述：生成的用于处理异步（延迟）MySQL 语句的工作者线程数。每个工作者线程都有自己的 MySQL 服务器连接。
#        默认：     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#
#    PlayerbotsDatabase.SynchThreads
#        描述：生成的用于处理的 MySQL 连接数。
#        默认：     1 - (PlayerbotDatabase.WorkerThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbot.Updates.EnableDatabases
#        描述：确定更新系统是否与玩家机器人数据库一起工作。
#
#        默认：     1  - （启用）
#                     0  - （禁用）

Playerbots.Updates.EnableDatabases = 0

# 命令服务器端口，0 - 禁用
AiPlayerbot.CommandServerPort = 8888

#
#
#
####################################################################################################

####################################################################################################
# DEBUG 开关
#
#

AiPlayerbot.SpellDump = 0
AiPlayerbot.LogInGroupOnly = 1
AiPlayerbot.LogValuesPerTick = 0
AiPlayerbot.RandomChangeMultiplier = 1

# 告诉避免了哪个法术（实验性）
# 默认：0（禁用）
AiPlayerbot.TellWhenAvoidAoe = 0

# 启用/禁用性能监视器
AiPlayerbot.PerfMonEnabled = 0

