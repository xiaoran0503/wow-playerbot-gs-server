[worldserver]

###################################################################################################
#  ELUNA 设置
#
#   Eluna.Enabled
#       描述：启用或禁用 Eluna Lua 引擎
#       默认值：true  -（启用）
#               false -（禁用）
#
#   Eluna.TraceBack
#       描述：设置是否在 Lua 错误时使用 debug.traceback 函数。
#             注意，您可以重新定义该函数。
#       默认值：false -（使用默认错误输出）
#               true  -（使用 debug.traceback 函数）
#
#   Eluna.ScriptPath
#       描述：设置脚本文件夹的路径，用于加载脚本
#             路径可以是相对路径或绝对路径。
#       默认值："lua_scripts"
#
#   Eluna.PlayerAnnounceReload
#       描述：启用或禁用是否向玩家发送重载公告（最低安全级别）。
#       默认值：false -（禁用）
#               true  -（启用）
#
#   Eluna.RequirePaths
#       描述：设置额外的 require 路径。
#             这些路径是绝对路径，并遵循标准的 Lua require 路径模式。
#             下面是一组大多数包管理器使用的“标准”路径。
#             "/usr/share/%s/?.lua;/usr/local/share/lua/%s/?.lua;/usr/local/share/lua/%s/?/init.lua;/usr/share/lua/%s/?.lua;/usr/share/lua/%s/?/init.lua;"
#       默认值：""
#
#   Eluna.RequireCPaths
#       描述：设置额外的 require C 路径。
#             这些路径是绝对路径，并遵循标准的 Lua require 路径模式。
#             下面是一组大多数包管理器使用的“标准”路径。
#             "/usr/local/lib/lua/%s/?.so;/usr/lib/x86_64-linux-gnu/lua/%s/?.so;/usr/local/lib/lua/%s/loadall.so;"
#       默认值：""


Eluna.Enabled = true
Eluna.TraceBack = false
Eluna.ScriptPath = "lua_scripts"
Eluna.PlayerAnnounceReload = false
Eluna.RequirePaths = ""
Eluna.RequireCPaths = ""

###################################################################################################
# 日志系统设置
#
#  日志记录器配置值：给定一个名为 "name" 的日志记录器
#    Logger.name
#        描述：定义“记录什么”
#        格式：    日志级别,记录器列表
#
#                     日志级别
#                         0 -（禁用）
#                         1 -（严重错误）
#                         2 -（错误）
#                         3 -（警告）
#                         4 -（信息）
#                         5 -（调试）
#                         6 -（详细信息）
#
#                     记录器列表：与日志记录器关联的记录器列表
#                     （使用空格分隔）。
#
#  日志记录器配置值：给定一个名为 "name" 的记录器
#    Logger.name
#        描述：定义“记录什么”
#        格式：    日志级别,记录器列表
#
#                     日志级别
#                         0 -（禁用）
#                         1 -（严重错误）
#                         2 -（错误）
#                         3 -（警告）
#                         4 -（信息）
#                         5 -（调试）
#                         6 -（详细信息）
#
#                     记录器列表：与日志记录器关联的记录器列表
#                     （使用空格分隔）。
#

Logger.eluna=4,ElunaLog ElunaConsole

#  记录器配置值：给定一个名为 "name" 的记录器
#    Appender.name
#        描述：定义“记录到哪里”。
#        格式：    类型,日志级别,标志,可选参数1,可选参数2,可选参数3
#
#                     类型
#                         0 -（无）
#                         1 -（控制台）
#                         2 -（文件）
#                         3 -（数据库）
#
#                     日志级别
#                         0 -（禁用）
#                         1 -（严重错误）
#                         2 -（错误）
#                         3 -（警告）
#                         4 -（信息）
#                         5 -（调试）
#                         6 -（详细信息）
#
#                     标志：
#                         0 - 无
#                         1 - 在文本前加上时间戳
#                         2 - 在文本前加上日志级别
#                         4 - 在文本前加上日志过滤器类型
#                         8 - 在日志文件名后加上时间戳。格式：YYYY-MM-DD_HH-MM-SS
#                             （仅用于类型 = 2）
#                         16 - 在覆盖前备份现有文件
#                             （仅用于模式 = w）
#
#                     颜色（如果类型 = 控制台，则作为可选参数1 读取）
#                         格式："严重错误 错误 警告 信息 调试 详细信息"
#                         0 - 黑色
#                         1 - 红色
#                         2 - 绿色
#                         3 - 棕色
#                         4 - 蓝色
#                         5 - 紫色
#                         6 - 青色
#                         7 - 灰色
#                         8 - 黄色
#                         9 - 浅红色
#                         10 - 浅绿色
#                         11 - 浅蓝色
#                         12 - 浅紫色
#                         13 - 浅青色
#                         14 - 白色
#                         示例："1 9 3 6 5 8"
#
#                     文件：文件名（如果类型 = 文件，则作为可选参数1 读取）
#                         允许使用一个 "%s" 来创建动态文件名
#
#                     模式：打开文件的模式（如果类型 = 文件，则作为可选参数2 读取）
#                          a -（追加）
#                          w -（覆盖）
#
#                     最大文件大小：在创建新日志文件之前的最大日志文件大小
#                         （如果类型 = 文件，则作为可选参数3 读取）
#                         大小以字节为单位，表示为 64 位无符号整数。
#                         最大值为 4294967295（4 GB）。留空表示无限制。
#                         注意：不支持动态文件名。
#                         示例：536870912（512 MB）
#
Appender.ElunaLog=2,5,0,eluna.log,w
Appender.ElunaConsole=1,4,0,"0 9 0 3 5 0"