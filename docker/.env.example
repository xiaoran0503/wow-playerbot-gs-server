# =============================================================================
# Playerbot 分支私服栈 .env 模板 — 复制为 docker/.env 并按注释填写
#   cp docker/.env.example docker/.env
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像引用 (CI/GitHub Actions 推送地址; <账号> 替换为你的 Docker Hub 账号)
# -----------------------------------------------------------------------------
# 认证服镜像
WOW_AUTHSERVER_IMAGE=docker.io/xiaoran05032/wow-playerbot-authserver:latest
# 世界服镜像 (含 6 个 vendor 模块静态链接)
WOW_WORLDSERVER_IMAGE=docker.io/xiaoran05032/wow-playerbot-worldserver:latest
# 一次性建库镜像 (仅 fresh-install profile 用)
WOW_DBIMPORT_IMAGE=docker.io/xiaoran05032/wow-playerbot-db-import:latest

# -----------------------------------------------------------------------------
# 数据库凭据 (MySQL 8.4 侧车; 必填)
# -----------------------------------------------------------------------------
# MySQL root 密码 (容器初始化时使用)
WOW_DB_ROOT_PASSWORD=请修改为强密码
# 业务账号 (auth/world/playerbots 连接用, 默认 wow_user)
WOW_DB_USER=wow_user
# 业务账号密码
WOW_DB_PASSWORD=请修改为强密码
# 数据库宿主机映射端口 (默认 3307, 避开本机 3306 潜在占用)
WOW_DB_HOST_PORT=3307

# -----------------------------------------------------------------------------
# 服务端口 (宿主机映射; 容器内固定 20241/20242)
# -----------------------------------------------------------------------------
# 认证服 (Realmlist/登录服务器) 宿主机端口
WOW_AUTH_PORT=20241
# 世界服 (游戏世界端口) 宿主机端口
WOW_WORLD_PORT=20242

# -----------------------------------------------------------------------------
# 客户端地图数据目录 (宿主机路径, 只读挂载进容器; 不要放进镜像)
# -----------------------------------------------------------------------------
# 需包含 maps/ vmaps/ mmaps/ dbc/ Cameras/ 子目录
WOW_DATA_DIR=E:\缓存\WOW\GS_Server\datalyf

# -----------------------------------------------------------------------------
# 注册门户 (profile=full, 默认不启动; 仅 -WithPortal / --profile full 时生效)
# -----------------------------------------------------------------------------
# 门户对外暴露的服务器地址 (玩家登录用 realmlist address, 通常填本机局域网 IP)
WOW_SERVER_ADDR=127.0.0.1
# 服务器/ realms 名称
WOW_REALM_NAME=魔兽世界
# 门户网页标题
PORTAL_TITLE=魔兽世界
# 门户镜像 (一般无需改; 本地构建时用 wow-portal:latest)
PORTAL_IMAGE=wow-portal:latest
# 门户宿主机 HTTP 端口
PORTAL_PORT=8081
